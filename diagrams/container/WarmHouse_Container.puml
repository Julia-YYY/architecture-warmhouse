@startuml WarmHouse_Container

' объявление RELATIVE_INCLUDE переключает на использование локальной копии C4-PlantUML
!$RELATIVE_INCLUDE = "."
!include ../C4-PlantUML/C4_Container.puml

LAYOUT_TOP_DOWN()
SHOW_PERSON_OUTLINE()

title Диаграмма контейнеров C4 — «Тёплый дом», состояние MVP (монолит в эксплуатации)

' Элементы и связи фазы 2 выделены отдельно
' ограничиваем эксплуатацию 4-6 службами (при команде из пяти человек,
' что указано в разделе ТЗ "Лендскейп компании").
' Фаза 2 - работа с комплектами и подписками.
AddElementTag("phase2", $borderColor="#707070", $borderStyle="dashed", $legendText="Фаза 2 — вне MVP")
AddRelTag("phase2_rel", $lineColor="#707070", $lineStyle="dashed", $legendText="Взаимодействие фазы 2")

' =====================================================================
' Внешние акторы и системы (для удобства  используются идентификаторы, совпадающие с диаграммой контекста)
' ====================================================================

Person_Ext(home_owner, "Владелец дома", "Клиент компании. Самостоятельно подключает модули умного дома и просматривает телеметрию")

System_Ext(smart_devices, "Умные устройства в доме", "Датчики, реле, приводы, камеры. Комплекты компании и устройства партнёров по стандартным протоколам")

System_Ext(identity_provider, "Провайдер идентификации", "Аутентифицирует пользователей, выпускает токены доступа")

System_Ext(notification_provider, "Провайдер уведомлений", "Доставка уведомлений по email и push")

System_Ext(payment_provider, "Платёжный провайдер", "Приём платежей и управление подписками по модели SaaS", $tags="phase2")

' =====================================================================
' Периметр системы
' =====================================================================

System_Boundary(warm_house_eco, "Тёплый дом") {

    ' --- клиентский слой ---
    Container(spa, "Веб-приложение", "TypeScript, SPA в браузере", "Подключение устройств, настройка сценариев, управление приборами, просмотр телеметрии")
    Container(api_gateway, "API Gateway", "C#", "Единая точка входа клиента: маршрутизация, проверка токена, ограничение частоты запросов")

    ' --- пограничный слой устройств ---
    ContainerQueue(mqtt_broker, "Брокер устройств", "MQTT", "Принимает телеметрию, события и статусы от устройств, доставляет команды, буферизует сообщения при недоступности сторон")
    Container(device_gateway, "Шлюз устройств", "C#", "Слой предотвращения искажений к отраслевому протоколу. Переводит в обе стороны: сообщения устройств — в модель возможностей, команды — в протокол устройства")

    ' --- шина внутренних событий ---
    ContainerQueue(event_bus, "Шина событий", "Kafka", "Публикация фактов домена: DeviceRegistered, TelemetryReceived, DeviceCommandCompleted, DeviceCommandFailed, ScenarioTriggered, PaymentCompleted")

    ' --- службы ---
    Container(onboarding_api, "Подключение устройств", "C#", "Регистрирует экземпляры устройств, ведёт реестр «тип → возможности → исполнитель команд», выдаёт учётные данные устройству. Core")
    Container(houses_api, "Дома и объекты", "C#", "Дома, владельцы, права доступа. Открытая служба для остальных контекстов")
    Container(device_management_api, "Управление устройствами", "C#", "Текущее состояние устройств, приём и маршрутизация команд")
    Container(telemetry_api, "Телеметрия", "C#", "Сохраняет ряды наблюдений и отдаёт их клиенту для построения графиков")
    Container(automation_api, "Сценарии автоматизации", "C#", "Проверяет условия пользовательских сценариев по входящим событиям. Core")
    Container(notification_api, "Уведомления", "C#", "Подписывается на события домена, применяет шаблоны и настройки пользователя")

    ' --- фаза 2: продажа комплектов и подписки ---
    Container(catalog_api, "Каталог и продажи", "C#", "Комплекты, цены, состав, наличие, оформление заказа", $tags="phase2")
    Container(billing_api, "Биллинг и подписки", "C#", "Тонкий слой перевода к платёжному провайдеру: состояние подписки и оплаты в собственных понятиях", $tags="phase2")

    ' --- хранилища: у каждой службы своё ---
    ContainerDb(onboarding_db, "Реестр устройств", "PostgreSQL", "Экземпляры устройств, их возможности, учётные данные, привязка к дому")
    ContainerDb(houses_db, "Дома и права доступа", "PostgreSQL", "Дома, владельцы, доступ пользователей к домам")
    ContainerDb(state_db, "Состояние устройств", "PostgreSQL", "Последнее известное состояние каждого устройства. Требование немедленной согласованности")
    ContainerDb(telemetry_db, "Хранилище телеметрии", "TimescaleDB", "Ряды наблюдений во времени. Запись преобладает над чтением")
    ContainerDb(automation_db, "Правила сценариев", "PostgreSQL", "Пользовательские сценарии: условия, действия, расписания")
    ContainerDb(catalog_db, "Каталог и заказы", "PostgreSQL", "Товарные позиции, состав комплектов, заказы", $tags="phase2")
    ContainerDb(billing_db, "Подписки и платежи", "PostgreSQL", "Состояние подписки, история платежей", $tags="phase2")

    ' --- унаследованное ядро, выводимое из эксплуатации ---
    Container(monolith, "Монолит «Тёплый дом» (As-Is)", "Go, Gin", "Действующее приложение: учёт датчиков и мониторинг температуры для 100 подключённых модулей отопления. Остаётся в эксплуатации на время MVP")
    Container(legacy_acl, "Слой предотвращения искажений к монолиту", "C#", "Единственный контейнер, знающий модель models.Sensor. Читает её через HTTP-API монолита, переводит в модель возможностей и обратно")
    ContainerDb(monolith_db, "БД монолита", "PostgreSQL", "Таблица sensors: описание типа, экземпляр и последнее показание в одной строке")
}

' =====================================================================
' Клиентский путь
' =====================================================================

Rel(home_owner, spa, "Подключает устройства, управляет приборами, просматривает телеметрию", "HTTPS")
Rel(spa, api_gateway, "Регистрация устройств, команды, запросы состояния и рядов наблюдений", "sync, JSON/HTTPS")
Rel(api_gateway, identity_provider, "Проверяет токен доступа", "HTTPS, OAuth 2.0")

Rel(api_gateway, onboarding_api, "Запросы регистрации устройств", "sync, JSON/HTTPS")
Rel(api_gateway, device_management_api, "Команды приборам и запросы текущего состояния", "sync, JSON/HTTPS")
Rel(api_gateway, telemetry_api, "Запросы рядов наблюдений", "sync, JSON/HTTPS")
Rel(api_gateway, automation_api, "Создание и изменение пользовательских сценариев", "sync, JSON/HTTPS")
Rel(api_gateway, catalog_api, "Просмотр комплектов и оформление заказа", "sync, JSON/HTTPS", $tags="phase2_rel")
Rel(api_gateway, monolith, "Маршрутизирует запросы, ещё не перенесённые в новые службы", "sync, JSON/HTTP")

' =====================================================================
' Службы и их хранилища
' =====================================================================

Rel(onboarding_api, onboarding_db, "Экземпляры устройств, возможности, учётные данные", "SQL/TCP")
Rel(houses_api, houses_db, "Дома, владельцы, права доступа", "SQL/TCP")
Rel(device_management_api, state_db, "Пишет и читает текущее состояние устройств", "SQL/TCP")
Rel(telemetry_api, telemetry_db, "Пишет и читает ряды наблюдений", "SQL/TCP")
Rel(automation_api, automation_db, "Правила, условия, действия, расписания", "SQL/TCP")
Rel(catalog_api, catalog_db, "Комплекты, состав, заказы", "SQL/TCP", $tags="phase2_rel")
Rel(billing_api, billing_db, "Состояние подписки и история платежей", "SQL/TCP", $tags="phase2_rel")
Rel(monolith, monolith_db, "Учёт датчиков и последнее показание", "SQL/TCP")

' =====================================================================
' Межслужебные синхронные вызовы (открытые службы)
' =====================================================================

Rel(onboarding_api, houses_api, "Проверяет принадлежность дома пользователю", "sync, JSON/HTTPS (OHS)")
Rel(device_management_api, houses_api, "Проверяет права пользователя на дом устройства", "sync, JSON/HTTPS (OHS)")
Rel(device_management_api, onboarding_api, "Читает возможности устройства и его исполнителя команд", "sync, JSON/HTTPS (OHS)")
Rel(automation_api, onboarding_api, "Читает возможности устройств для формулировки условий и действий", "sync, JSON/HTTPS (OHS)")
Rel(automation_api, device_management_api, "Отправляет команду при выполнении условия сценария", "sync, JSON/HTTPS")

' оплата инициируется биллингом
Rel(catalog_api, billing_api, "Запрашивает оплату оформленного заказа", "sync, JSON/HTTPS", $tags="phase2_rel")
Rel(billing_api, payment_provider, "Инициирует списание, получает статус платежа", "HTTPS, REST (тонкий ACL)", $tags="phase2_rel")

' =====================================================================
' Пограничный слой устройств: перевод в обе стороны
' =====================================================================

Rel(onboarding_api, mqtt_broker, "Регистрирует учётные данные и топики устройств", "HTTPS, API управления брокером")
Rel(device_management_api, device_gateway, "Передаёт команды в модели возможностей", "sync, JSON/HTTPS")
Rel(device_gateway, mqtt_broker, "Публикует команды в топики устройств в их протоколе", "MQTT")
Rel(mqtt_broker, smart_devices, "Доставляет команды", "MQTT/TLS")
Rel(smart_devices, mqtt_broker, "Публикуют показания, события и статусы исполнения", "MQTT, async")
Rel(mqtt_broker, device_gateway, "Доставляет сообщения устройств", "MQTT, подписка")

' =====================================================================
' Публикация фактов домена
' =====================================================================

Rel(onboarding_api, event_bus, "Публикует DeviceRegistered", "async, Kafka")
Rel(device_gateway, event_bus, "Публикует TelemetryReceived и результаты команд", "async, Kafka")
Rel(legacy_acl, event_bus, "Публикует те же события по унаследованным устройствам", "async, Kafka")
Rel(automation_api, event_bus, "Публикует ScenarioTriggered", "async, Kafka")
Rel(billing_api, event_bus, "Публикует PaymentCompleted и SubscriptionActivated", "async, Kafka", $tags="phase2_rel")

Rel(event_bus, device_management_api, "Регистрация устройств, наблюдения, результаты команд", "async, Kafka")
Rel(event_bus, telemetry_api, "Регистрация устройств, наблюдения", "async, Kafka")
Rel(event_bus, automation_api, "Регистрация устройств, наблюдения", "async, Kafka")
Rel(event_bus, notification_api, "Регистрация устройств, отказы команд, срабатывания сценариев, оплаты", "async, Kafka")
Rel(event_bus, onboarding_api, "Оплаченные комплекты: устройства, готовые к подключению", "async, Kafka", $tags="phase2_rel")
' шлюзу нужны протокол и профиль возможностей каждого устройства; синхронное
' чтение реестра на каждое сообщение недопустимо — отсюда подписка (см. диаграмму компонентов)
Rel(event_bus, device_gateway, "Регистрация устройств: протокол и профиль возможностей", "async, Kafka")

Rel(notification_api, notification_provider, "Отправляет уведомления и отчёты", "HTTPS, REST")

' =====================================================================
' Интеграция с монолитом — обязательное требование MVP.
' Оба направления Strangler Fig: маршрутизация запросов в монолит
' (выше) и подъём его данных в новую модель (здесь).
' =====================================================================

Rel(device_management_api, legacy_acl, "Передаёт команды унаследованным устройствам", "sync, JSON/HTTPS")
Rel(legacy_acl, monolith, "Читает датчики и показания, вызывает управление отоплением", "sync, JSON/HTTP (API монолита)")
Rel(monolith, smart_devices, "Опрашивает температуру и переключает реле ранее подключённых модулей", "HTTP, синхронный опрос (pull)")

' =====================================================================
' Пояснения
' =====================================================================

note as N_rules
  **Принципы, по которым происходило проектирование**
  ....
  Ни одна служба не читает хранилище другой службы:
  чужие данные доступны только через API или событие.
  ....
  Факт с несколькими потребителями публикуется в шину
  один раз.
  ....
  Команда адресована одному исполнителю, поэтому доставляется
  точечно. В шину публикуются только её результаты — это факты.
  ....
  Клиент обращается только к шлюзу, а не к службам напрямую.
  ....
  Оба слоя предотвращения искажений симметричны: переводят
  и входящее, и исходящее. Ни одна служба не знает протоколов
  устройств и модели монолита — иначе поддержка нового
  протокола требовала бы их правки.
  ....
  Телеметрия хранится отдельно от состояния устройств, поскольку
  профили нагрузки несовместимы.
  ....
  Уведомление отправляется тогда, когда пользователь не может
  узнать о событии сам: отказ команды, срабатывание сценария
  в его отсутствие, оплата. Успешное нажатие выключателя
  уведомления не порождает.
end note

note as N_scenario6
  **устройство неизвестного типа не добавляет связей**
  ....
  Это не пропуск, а проверка остальных пяти. Подключение
  устройства типа, не предусмотренного при проектировании,
  сводится к записи в реестре «тип → возможности → исполнитель
  команд» службы подключения. Ни один контейнер и ни одна связь
  при этом не появляются: тип устройства является данными,
  а не кодом.
  ....
  Проверяется по сценариям 2-4: телеметрия, управление
  и автоматизация оперируют возможностями, а не типами,
  и потому применимы к устройству, которого не существовало
  на момент их написания.
  ....
  Неизвестен может быть тип, либо протокол.
  Незнакомый тип поверх известного протокола не требует изменений
  вовсе. Незнакомый протокол требует нового протокольного
  адаптера — но **внутри** шлюза устройств, получаем изменение
  уровня компонентов (не контейнеров).
end note

note as N_open
  **Принятые решения (согласно ТЗ)**
  ....
  **Состояние системы.** Состояние MVP: монолит
  остаётся в эксплуатации, интеграция с ним обязательна.
  В целевом состоянии должны исчезнуть монолит, его БД, слой
  предотвращения искажений, маршрутизация запросов
  из шлюза в монолит; предполагается, что это вне рамок задачи.
  ....
  **Унаследованные устройства неотличимы ниже слоя перевода.**
  Слой публикует те же события домена, что и новые устройства,
  поэтому вывод монолита не потребует правок в службах-
  потребителях.
  ....
  **Два брокера.** Пограничный MQTT для устройств и внутренняя
  шина фактов разделены: разные протоколы, профили нагрузки
  и модели сообщений.
  ....
  **Стек.** Существующий монолит написан на Go (ТЗ, раздел 1),
  весь новый код — на C#. Основание — компетенции команды
  разработки. Принятая цена: функции монолита переписываются,
  а не переносятся; цена ограничена тем, что монолит невелик
  и его модель всё равно подлежит замене. Знание Go не требуется
  ни в одном новом контейнере — слой предотвращения искажений
  читает монолит через HTTP-API, а не через БД.
  ....
  **Проверка прав доступа — синхронная.** Выбрано, чтобы получать свежие
  данные. Альтернатива — локальная проекция «дом → владелец»,
  обновляемая событиями: более доступная, но данные менее свежие.
  ....
  **Границы MVP.** Ограничиваем
  эксплуатацию четырьмя-шестью службами при команде из пяти
  человек. В MVP входят шесть служб домена — подключение,
  дома и объекты, управление устройствами, телеметрия, сценарии,
  уведомления — плюс шлюзы, слой перевода и монолит. Каталог
  и биллинг вынесены в фазу 2 (пунктир): бизнес-цель (по тексту ТЗ) 
  называет MVP как «микросервисы для управления отоплением, освещением,
  наблюдением, воротами» и не упоминает продажу комплектов.
  ....
  **Действие сценария — команда, а не событие.** Автоматизация
  вызывает управление устройствами точечно, по тому же доводу,
  что и команда пользователя: у команды один исполнитель.
  Событием является факт срабатывания сценария, и он публикуется.

end note

note as N_scope
  **Вне ТЗ**
  ....
  Видеонаблюдение не изображено: ни один пунктов ТЗ
  его не задействует.
  ....
  Хранилище уведомлений опущено: шаблоны и настройки доставки
  в прослеженных сценариях не изменяются. Служба не является
  от этого не имеющей состояния.
  ....
  Сотрудник поддержки и контролирующий орган с диаграммы
  контекста в этих сценариях не участвуют.
end note

SHOW_LEGEND()

@enduml
