@startuml WarmHouse_Context_As_Is

' объявление RELATIVE_INCLUDE переключает на использование локальной копии C4-PlantUML
!$RELATIVE_INCLUDE = "."
!include ../C4-PlantUML/C4_Context.puml

LAYOUT_TOP_DOWN()
SHOW_PERSON_OUTLINE()

title Диаграмма контекста C4 — «Тёплый дом», текущее состояние (As-Is)

' =====================================================================
' Внешние акторы 
' =====================================================================

Person_Ext(home_owner, "Владелец дома", "Клиент компании, имеющий один или несколько домов с установленной системой отопления")

' =====================================================================
' Внешние системы
' =====================================================================

System_Ext(heating_devices, "Датчики температуры и реле отопления", "Оборудование, установленное в домах клиентов. Производится третьими лицами, находится вне периметра компании")

' =====================================================================
' Периметр компании: система и её внутренние пользователи
' =====================================================================

Enterprise_Boundary(warm_house_company, "Компания «Тёплый дом»") {

    System(warm_house, "Тёплый дом", "Система удалённого управления отоплением и мониторинга температуры в доме")

    Person(field_engineer, "Специалист по подключению", "Выезжает на объект и подключает оборудование дома к системе")

    Person(support_agent, "Сотрудник поддержки", "Обрабатывает обращения клиентов и диагностирует неисправности")
}

' =====================================================================
' Связи.
' =====================================================================

Rel(home_owner, warm_house, "Управляет отоплением и просматривает текущую температуру", "HTTPS, веб-интерфейс")

Rel(field_engineer, warm_house, "Регистрирует и настраивает оборудование дома вручную после выезда на объект", "HTTPS, веб-интерфейс")

Rel(support_agent, warm_house, "Диагностирует обращения клиентов", "HTTPS, веб-интерфейс")

' Ключевая связь As-Is: инициатором выступает сервер, а не устройство
Rel(warm_house, heating_devices, "Опрашивает температуру и передаёт команды управления", "HTTP, синхронный опрос (pull)")

' =====================================================================
' Контекст текущего состояния
' =====================================================================

note as N_as_is
  **Текущее состояние**
  ....
  Монолитное приложение на Go, СУБД PostgreSQL.
  Все взаимодействия синхронные: асинхронного обмена,
  очередей и событийной модели в системе нет.
  ....
  Масштаб: 100 веб-клиентов, 100 модулей управления отоплением.
  Развёртывание требует полной остановки приложения.
  ....
  Подключение каждого дома выполняется вручную и требует
  выезда специалиста. Самостоятельно подключить датчик
  клиент не может.
end note

SHOW_LEGEND()

@enduml
