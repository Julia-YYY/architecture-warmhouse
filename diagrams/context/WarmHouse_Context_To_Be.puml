@startuml WarmHouse_Context_To_Be

' объявление RELATIVE_INCLUDE переключает на использование локальной копии C4-PlantUML

!$RELATIVE_INCLUDE = "."
!include ../C4-PlantUML/C4_Context.puml

LAYOUT_TOP_DOWN()
SHOW_PERSON_OUTLINE()

title Диаграмма контекста C4 — «Тёплый дом», целевое состояние (To-Be)

' =====================================================================
' Внешние акторы
' =====================================================================

Person(home_owner, "Владелец дома", "Клиент компании. Самостоятельно выбирает, покупает и подключает модули умного дома, настраивает сценарии их работы")

Person_Ext(regulator, "Контролирующий орган", "Надзор за обработкой персональных данных видеонаблюдения и за безопасностью управления приборами. Допущение — см. примечание")

' =====================================================================
' Внешние системы
' =====================================================================

System_Ext(smart_devices, "Умные устройства в доме", "Датчики, реле, камеры наблюдения, приводы ворот. Собственные комплекты компании и устройства партнёров, подключаемые по стандартным протоколам")

System_Ext(payment_provider, "Платёжный провайдер", "Приём платежей и управление подписками по модели SaaS")

System_Ext(notification_provider, "Провайдер уведомлений", "Доставка уведомлений и отчётов по email и push")

' =====================================================================
' Периметр компании: система и её внутренние пользователи
' =====================================================================

Enterprise_Boundary(warm_house_company, "Компания «Тёплый дом»") {

    System(warm_house_eco, "Тёплый дом", "Экосистема умного дома по модели SaaS: самостоятельное подключение устройств, управление отоплением, освещением, воротами и наблюдением, программируемые сценарии и телеметрия")

    Person(support_agent, "Сотрудник поддержки", "Обрабатывает обращения клиентов и диагностирует неисправности")
}

' =====================================================================
' Связи.
' =====================================================================

Rel(home_owner, warm_house_eco, "Подключает устройства, настраивает сценарии, управляет ими и просматривает телеметрию", "HTTPS")

Rel(support_agent, warm_house_eco, "Диагностирует обращения клиентов", "HTTPS, веб-интерфейс")

' Ключевое отличие от As-Is: инициатором передачи данных выступает устройство
Rel(smart_devices, warm_house_eco, "Передают телеметрию и события", "MQTT, асинхронно (push)")
Rel(warm_house_eco, smart_devices, "Направляет команды управления", "MQTT, асинхронно")

Rel(warm_house_eco, payment_provider, "Инициирует списание по подписке и покупке комплектов", "HTTPS, REST")

Rel(warm_house_eco, notification_provider, "Отправляет уведомления о событиях и периодические отчёты", "HTTPS, REST")

Rel(regulator, warm_house_eco, "Запрашивает данные для проверки соблюдения требований", "HTTPS")

' =====================================================================
' Контекст целевого состояния
' =====================================================================

note as N_to_be
  Целевое состояние
  ....
  Экосистема доступна по модели SaaS в режиме самообслуживания.
  ....
  Специалист по подключению отсутствует — сравните с диаграммой
  As-Is. Выезд мастера на установку заменён самостоятельным
  подключением устройств клиентом.
  ....
  Взаимодействие с устройствами асинхронное: телеметрию передают
  сами устройства, система направляет команды. Это снимает
  ограничение синхронного опроса, действующее в As-Is.
  ....
  Поддерживаются устройства партнёров по стандартным протоколам,
  включая типы, неизвестные на момент проектирования.
end note

note as N_assumptions
  Допущения
  ....
  «Контролирующий орган» в ТЗ прямо не назван. Основание —
  обработка персональных данных при удалённом видеонаблюдении
  и требования безопасности к управлению приборами и воротами.
  ....
  «Платёжный провайдер» в ТЗ прямо не назван. Следует из модели
  SaaS с самообслуживанием и продажи отдельных комплектов.
end note

SHOW_LEGEND()

@enduml