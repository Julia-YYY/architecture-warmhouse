@startuml WarmHouse_Component

' объявление RELATIVE_INCLUDE переключает на использование локальной копии C4-PlantUML
!$RELATIVE_INCLUDE = "."
!include ../C4-PlantUML/C4_Component.puml

LAYOUT_TOP_DOWN()

title Диаграмма компонентов C4 — «Управление устройствами» и «Шлюз устройств»

' Точки расширения: места, куда добавляется новый вариант поведения
' без правки остальных компонентов.
AddElementTag("ext_point", $borderColor="#2E7D32", $fontColor="#1B5E20", $legendText="Точка расширения — новый вариант добавляется без правки остальных компонентов")

' =====================================================================
' Соседние контейнеры
' =====================================================================

System_Ext(smart_devices, "Умные устройства в доме", "Датчики, реле, приводы, камеры")

Container(api_gateway, "API Gateway", "C#", "Единая точка входа клиента")
Container(automation_api, "Сценарии автоматизации", "C#", "Действие сценария приходит как команда")
Container(houses_api, "Дома и объекты", "C#", "Открытая служба: дома, владельцы, права доступа")
Container(onboarding_api, "Подключение устройств", "C#", "Открытая служба: реестр «тип → возможности → протокол → исполнитель команд»")
Container(legacy_acl, "Слой предотвращения искажений к монолиту", "C#", "Путь к унаследованным модулям отопления")

ContainerQueue(event_bus, "Шина событий", "Kafka", "Факты домена")
ContainerQueue(mqtt_broker, "Брокер устройств", "MQTT", "Пограничный брокер")

ContainerDb(state_db, "Состояние устройств", "PostgreSQL", "Последнее известное состояние каждого устройства")

' =====================================================================
' Контейнер 1. Управление устройствами
' =====================================================================

Container_Boundary(dm, "Управление устройствами") {

    ' --- адаптеры границ: по одному на каждый чужой контракт ---
    Component(dm_api, "API команд и состояния", "C# / ASP.NET Core", "Принимает команды и запросы состояния по HTTP, проверяет форму запроса. Один компонент на два источника: контракт у шлюза и автоматизации общий")
    Component(dm_event_consumer, "Подписчик событий домена", "C# / Kafka consumer", "Читает DeviceRegistered, TelemetryReceived, результаты команд и передаёт их менеджеру состояния")
    Component(dm_state_repo, "Репозиторий состояния", "C# / EF Core", "Единственный компонент, знающий схему хранилища состояния")
    Component(dm_houses_client, "Клиент домов и объектов", "C# / HTTP client", "Читает права пользователя на дом устройства")
    Component(dm_registry_client, "Клиент реестра устройств", "C# / HTTP client", "Читает возможности устройства и его исполнителя команд")

    ' --- доменные компоненты: места принятия решений ---
    Component(dm_command_handler, "Обработчик команд", "C#", "Решает, допустима ли команда: есть ли у пользователя право на дом и поддерживает ли устройство запрошенную возможность")
    Component(dm_command_router, "Маршрутизатор исполнителей", "C#", "Решает, кто исполнит команду, по исполнителю из реестра. Ветви А и Б взаимоисключающие")
    Component(dm_state_manager, "Менеджер состояния устройств", "C#", "Ведёт состояние «команда отправлена — подтверждена — отклонена», применяет наблюдения, отбрасывает устаревшие события")

    ' --- исполнители: одинаковый интерфейс, разные реализации ---
    Component(dm_gateway_executor, "Исполнитель через шлюз устройств", "C#", "Отправляет команду в модели возможностей устройству, подключённому напрямую", $tags="ext_point")
    Component(dm_legacy_executor, "Исполнитель через монолит", "C#", "Отправляет команду унаследованному модулю отопления", $tags="ext_point")
}

' =====================================================================
' Контейнер 2. Шлюз устройств
' =====================================================================

Container_Boundary(gw, "Шлюз устройств") {

    ' --- адаптеры границ ---
    Component(gw_command_api, "API приёма команд", "C# / ASP.NET Core", "Принимает команду в модели возможностей от управления устройствами")
    Component(gw_device_subscriber, "Подписчик брокера устройств", "C# / MQTT client", "Читает топики устройств: показания, события, статусы исполнения")
    Component(gw_device_publisher, "Издатель в брокер устройств", "C# / MQTT client", "Публикует закодированную команду в топик конкретного устройства")
    Component(gw_event_publisher, "Издатель событий домена", "C# / Kafka producer", "Публикует TelemetryReceived, DeviceCommandCompleted, DeviceCommandFailed")
    ComponentDb(gw_registry_projection, "Проекция реестра устройств", "C#, локальное хранилище", "Читаемая копия «устройство → протокол → профиль возможностей», обновляемая событием DeviceRegistered. Синхронный вызов на каждое сообщение устройства недопустим")

    ' --- решения ---
    Component(gw_adapter_registry, "Реестр протокольных адаптеров", "C#", "Решает, каким адаптером обрабатывать сообщение или команду, по протоколу устройства из проекции")
    Component(gw_capability_mapper, "Преобразователь модели возможностей", "C#", "Переводит смысл: показание прибора — в наблюдение возможности и обратно. Единицы, шкалы, перечисления берутся из профиля типа")

    ' --- точки расширения: по адаптеру на протокол, оба направления в одном компоненте ---
    Component(gw_adapter_native, "Адаптер протокола комплектов компании", "C#", "Кодирует команду и разбирает сообщение в собственном формате комплектов", $tags="ext_point")
    Component(gw_adapter_partner, "Адаптер стандартного протокола партнёров", "C#", "То же для устройств партнёров по стандартному отраслевому протоколу", $tags="ext_point")
}

' =====================================================================
' Управление устройствами: приём команды
' =====================================================================

Rel(api_gateway, dm_api, "Команды приборам и запросы текущего состояния", "sync, JSON/HTTPS")
Rel(automation_api, dm_api, "Команда как действие сработавшего сценария", "sync, JSON/HTTPS")
Rel(event_bus, dm_event_consumer, "Регистрация устройств, наблюдения, результаты команд", "async, Kafka")

Rel(dm_api, dm_command_handler, "Передаёт разобранную команду", "вызов в процессе")
Rel(dm_api, dm_state_manager, "Запрашивает текущее состояние устройства", "вызов в процессе")

Rel(dm_command_handler, dm_houses_client, "Проверяет права на дом устройства", "вызов в процессе")
Rel(dm_houses_client, houses_api, "Читает права доступа", "sync, JSON/HTTPS (OHS)")
Rel(dm_command_handler, dm_registry_client, "Запрашивает возможности устройства и его исполнителя", "вызов в процессе")
Rel(dm_registry_client, onboarding_api, "Читает запись реестра", "sync, JSON/HTTPS (OHS)")
Rel(dm_command_handler, dm_state_manager, "Фиксирует «команда отправлена, подтверждение не получено»", "вызов в процессе")

' =====================================================================
' Управление устройствами: выбор исполнителя и отправка
' =====================================================================

Rel(dm_command_handler, dm_command_router, "Передаёт допустимую команду вместе с записью реестра", "вызов в процессе")
Rel(dm_command_router, dm_gateway_executor, "А. Устройство подключено напрямую", "вызов через общий интерфейс")
Rel(dm_command_router, dm_legacy_executor, "Б. Устройство унаследовано от монолита", "вызов через общий интерфейс")

Rel(dm_gateway_executor, gw_command_api, "Команда в модели возможностей", "sync, JSON/HTTPS")
Rel(dm_legacy_executor, legacy_acl, "Команда унаследованному устройству", "sync, JSON/HTTPS")

Rel(dm_event_consumer, dm_state_manager, "Применяет результат команды и наблюдения", "вызов в процессе")
Rel(dm_state_manager, dm_state_repo, "Пишет и читает состояние", "вызов в процессе")
Rel(dm_state_repo, state_db, "Состояние устройств", "SQL/TCP")

' =====================================================================
' Шлюз устройств: команда наружу (перевод из модели возможностей)
' =====================================================================

Rel(gw_command_api, gw_adapter_registry, "Передаёт команду возможности", "вызов в процессе")
Rel(gw_adapter_registry, gw_adapter_native, "Выбирает по протоколу устройства", "вызов через общий интерфейс")
Rel(gw_adapter_registry, gw_adapter_partner, "Выбирает по протоколу устройства", "вызов через общий интерфейс")
Rel(gw_adapter_registry, gw_registry_projection, "Читает протокол устройства", "вызов в процессе")

Rel(gw_adapter_native, gw_capability_mapper, "Переводит смысл в обе стороны", "вызов в процессе")
Rel(gw_adapter_partner, gw_capability_mapper, "Переводит смысл в обе стороны", "вызов в процессе")
Rel(gw_capability_mapper, gw_registry_projection, "Читает профиль возможностей типа", "вызов в процессе")

Rel(gw_adapter_native, gw_device_publisher, "Закодированная команда и топик", "вызов в процессе")
Rel(gw_adapter_partner, gw_device_publisher, "Закодированная команда и топик", "вызов в процессе")
Rel(gw_device_publisher, mqtt_broker, "Публикует команду в топик устройства", "MQTT")
Rel(mqtt_broker, smart_devices, "Доставляет команду", "MQTT/TLS")

' =====================================================================
' Шлюз устройств: сообщение внутрь (перевод в модель возможностей)
' =====================================================================

Rel(smart_devices, mqtt_broker, "Публикуют показания, события и статусы исполнения", "MQTT, async")
Rel(mqtt_broker, gw_device_subscriber, "Доставляет сообщения устройств", "MQTT, подписка")
Rel(gw_device_subscriber, gw_adapter_registry, "Передаёт сырое сообщение и топик", "вызов в процессе")
Rel(gw_adapter_native, gw_event_publisher, "Наблюдение или результат команды в модели возможностей", "вызов в процессе")
Rel(gw_adapter_partner, gw_event_publisher, "Наблюдение или результат команды в модели возможностей", "вызов в процессе")
Rel(gw_event_publisher, event_bus, "Публикует TelemetryReceived и результаты команд", "async, Kafka")

Rel(event_bus, gw_registry_projection, "Доставляет DeviceRegistered: протокол и профиль возможностей", "async, Kafka")

' =====================================================================
' Пояснения
' =====================================================================

note as N_extension
  **Проверка сценарием 6: что меняется при расширении**
  ....
  **Новый тип устройства поверх известного протокола** — ни один
  компонент. Профиль возможностей приходит в проекцию реестра
  событием DeviceRegistered, преобразователь читает его как
  данные. Это и есть обоснование записи на диаграмме контейнеров:
  тип устройства является данными, а не кодом.
  ....
  **Новая возможность (например, Positionable для ворот)** —
  ни один компонент управления устройствами: обработчик команд
  сверяет команду с возможностями из реестра, менеджер состояния
  хранит состояние как «возможность → значение».
  ....
  **Новый отраслевой протокол** — один новый адаптер (зелёная
  рамка) и запись в реестре. Реестр адаптеров, преобразователь,
  издатель и подписчик не меняются.
  ....
  **Новая унаследованная система** — один новый исполнитель
  (зелёная рамка). Маршрутизатор не меняется, потому что
  выбирает по данным реестра.
  ....
  Если бы при любом из этих изменений правке подлежал более чем
  один компонент, границы были бы проведены неверно.
end note

note as N_symmetry
  **Почему адаптер один на оба направления**
  ....
  Один и тот же протокольный адаптер и кодирует команду, и
  разбирает сообщение устройства. Разделение на «входящий»
  и «исходящий» компоненты разнесло бы знание об одном формате
  по двум местам, и поддержка протокола перестала бы быть
  локальной. Это компонентное выражение симметрии слоя
  предотвращения искажений, заявленной на уровне контейнеров.
  ....
  **Адаптер и преобразователь разделены намеренно.** Адаптер
  знает формат провода и свой протокол. Преобразователь знает
  смысл: единицы, шкалы, перечисления возможностей — и общий
  для всех протоколов. Слияние их означало бы дублирование
  модели возможностей в каждом адаптере.
end note

SHOW_LEGEND()

@enduml
