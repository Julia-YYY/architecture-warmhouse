@startuml WarmHouse_Telemetry

' объявление RELATIVE_INCLUDE переключает на использование локальной копии C4-PlantUML
!$RELATIVE_INCLUDE = "."
!include ../C4-PlantUML/C4_Dynamic.puml

LAYOUT_TOP_DOWN()
SHOW_PERSON_OUTLINE()

title Диаграмма динамики C4 — сценарий 2: устройство передаёт телеметрию, пользователь смотрит график

' =====================================================================
' Участники сценария
' =====================================================================

Person_Ext(home_owner, "Владелец дома", "Клиент компании")
System_Ext(smart_devices, "Умные устройства в доме", "Датчики, реле, приводы, камеры")

System_Boundary(warm_house_eco, "Тёплый дом") {
    Container(spa, "Веб-приложение", "TypeScript, SPA в браузере")
    Container(api_gateway, "API Gateway", "C#")

    ContainerQueue(mqtt_broker, "Брокер устройств", "MQTT")
    Container(device_gateway, "Шлюз устройств", "C#", "Слой предотвращения искажений к отраслевому протоколу")
    ContainerQueue(event_bus, "Шина событий", "Kafka")

    Container(telemetry_api, "Телеметрия", "C#")
    Container(device_management_api, "Управление устройствами", "C#")
    Container(automation_api, "Сценарии автоматизации", "C#", "Core")

    ContainerDb(telemetry_db, "Хранилище телеметрии", "TimescaleDB")
    ContainerDb(state_db, "Состояние устройств", "PostgreSQL")

    ' --- унаследованный источник тех же наблюдений ---
    Container(monolith, "Монолит «Тёплый дом» (As-Is)", "Go, Gin")
    Container(legacy_acl, "Слой предотвращения искажений к монолиту", "C#")
    ContainerDb(monolith_db, "БД монолита", "PostgreSQL")
}

' =====================================================================
' Ветвь А. Новое устройство: инициатор передачи — само устройство.
' Ключевое отличие от As-Is, где инициатором был сервер.
' =====================================================================

Rel(smart_devices, mqtt_broker, "А. Публикуют показания и события", "MQTT, async")
Rel(mqtt_broker, device_gateway, "А. Доставляет сообщения устройств", "MQTT, подписка")
Rel(device_gateway, event_bus, "А. Публикует TelemetryReceived\nв модели возможностей", "async, Kafka")

' =====================================================================
' Ветвь Б. Унаследованный датчик: синхронный опрос сохраняется,
' но заканчивается тем же событием, что и ветвь А.
' =====================================================================

Rel(monolith, smart_devices, "Б. Опрашивает температуру ранее подключённых датчиков", "HTTP, синхронный опрос (pull)")
Rel(monolith, monolith_db, "Б. Пишет последнее показание", "SQL/TCP")
Rel(legacy_acl, monolith, "Б. Читает показания через API монолита", "sync, JSON/HTTP")
Rel(legacy_acl, event_bus, "Б. Публикует TelemetryReceived\nв той же модели возможностей", "async, Kafka")

' =====================================================================
' Схождение ветвей: потребители не различают источник
' =====================================================================

Rel(event_bus, telemetry_api, "Доставляет TelemetryReceived", "async, Kafka")
RelIndex(LastIndex(), event_bus, device_management_api, "Доставляет TelemetryReceived", "async, Kafka")
RelIndex(LastIndex(), event_bus, automation_api, "Доставляет TelemetryReceived", "async, Kafka")

Rel(telemetry_api, telemetry_db, "Пишет ряд наблюдений", "SQL/TCP")
Rel(device_management_api, state_db, "Обновляет текущее состояние", "SQL/TCP")

' =====================================================================
' Чтение пользователем
' =====================================================================

Rel(home_owner, spa, "Открывает график показаний", "HTTPS")
Rel(spa, api_gateway, "Запрашивает ряд наблюдений", "sync, JSON/HTTPS")
Rel(api_gateway, telemetry_api, "Передаёт запрос ряда наблюдений", "sync, JSON/HTTPS")
Rel(telemetry_api, telemetry_db, "Читает ряд за период", "SQL/TCP")

' =====================================================================
' Пояснения
' =====================================================================

note as N_decisions
  **Решения разработанного сценария**
  ....
  **Две ветви сходятся в одном событии.** Новое устройство
  публикует показания само, унаследованное опрашивается
  монолитом по-старому — но оба слоя предотвращения искажений
  выдают TelemetryReceived в одной модели возможностей.
  Ниже шины разницы между источниками нет, поэтому вывод
  монолита из эксплуатации не затронет ни одного потребителя.
  ....
  **Три потребителя одного наблюдения.** Телеметрия пишет ряд,
  управление обновляет текущее состояние, сценарии проверяют
  триггер.
  ....
  **Телеметрия и состояние — разные хранилища.** Ряд наблюдений
  пишется много и читается редко, текущее состояние читается
  постоянно и требует немедленной согласованности. Профили
  нагрузки несовместимы.
  ....
  **Устройство не вызывает службу телеметрии напрямую.**
  Брокер буферизует сообщения при недоступности служб и
  снимает с устройства знание о внутреннем устройстве системы.
end note

note as N_scope
  **Границы сценария**
  ....
  Ветвь Б показывает, что синхронный опрос из As-Is
  на время MVP сохраняется. В целевом состоянии исчезают
  монолит, его БД и слой предотвращения искажений к нему;
  ветвь А не меняется.
    ....
  Полная структура — diagrams/container/WarmHouse_Container.puml.
end note

SHOW_LEGEND()

@enduml
