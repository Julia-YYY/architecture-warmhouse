@startuml WarmHouse_DeviceManagement

' объявление RELATIVE_INCLUDE переключает на использование локальной копии C4-PlantUML
!$RELATIVE_INCLUDE = "."
!include ../C4-PlantUML/C4_Dynamic.puml

LAYOUT_TOP_DOWN()
SHOW_PERSON_OUTLINE()

title Диаграмма динамики C4 — сценарий 3: пользователь включает отопление или свет

' =====================================================================
' Участники сценария
' =====================================================================

Person_Ext(home_owner, "Владелец дома", "Клиент компании")
System_Ext(smart_devices, "Умные устройства в доме", "Датчики, реле, приводы, камеры")
System_Ext(identity_provider, "Провайдер идентификации", "Аутентифицирует пользователей")
System_Ext(notification_provider, "Провайдер уведомлений", "Доставка по email и push")

System_Boundary(warm_house_eco, "Тёплый дом") {
    Container(spa, "Веб-приложение", "TypeScript, SPA в браузере")
    Container(api_gateway, "API Gateway", "C#")

    Container(device_management_api, "Управление устройствами", "C#")
    Container(houses_api, "Дома и объекты", "C#")
    Container(onboarding_api, "Подключение устройств", "C#", "Core")
    Container(notification_api, "Уведомления", "C#")

    Container(device_gateway, "Шлюз устройств", "C#", "Слой предотвращения искажений к отраслевому протоколу")
    ContainerQueue(mqtt_broker, "Брокер устройств", "MQTT")
    ContainerQueue(event_bus, "Шина событий", "Kafka")

    ContainerDb(state_db, "Состояние устройств", "PostgreSQL")
    ContainerDb(houses_db, "Дома и права доступа", "PostgreSQL")

    ' --- путь к унаследованным устройствам ---
    Container(legacy_acl, "Слой предотвращения искажений к монолиту", "C#")
    Container(monolith, "Монолит «Тёплый дом» (As-Is)", "Go, Gin")
}

' =====================================================================
' Приём команды. Команда адресована одному исполнителю, 
' доставляется точечно. Событиями являются только её результаты.
' =====================================================================

Rel(home_owner, spa, "Нажимает «включить»", "HTTPS")
Rel(spa, api_gateway, "Отправляет команду устройству", "sync, JSON/HTTPS")
Rel(api_gateway, identity_provider, "Проверяет токен доступа", "HTTPS, OAuth 2.0 / OIDC")
Rel(api_gateway, device_management_api, "Передаёт команду", "sync, JSON/HTTPS")

Rel(device_management_api, houses_api, "Проверяет права пользователя на дом устройства", "sync, JSON/HTTPS")
Rel(houses_api, houses_db, "Читает права доступа", "SQL/TCP")
Rel(device_management_api, onboarding_api, "Читает возможности устройства\nи его исполнителя команд", "sync, JSON/HTTPS (OHS)")
Rel(device_management_api, state_db, "Пишет состояние «команда отправлена,\nподтверждение не получено»", "SQL/TCP")

' =====================================================================
' Ветвь А. Устройство подключено к экосистеме напрямую.
' Перевод в протокол устройства выполняет шлюз.
' =====================================================================

Rel(device_management_api, device_gateway, "А. Передаёт команду в модели возможностей", "sync, JSON/HTTPS")
Rel(device_gateway, mqtt_broker, "А. Публикует команду в топик устройства\nв его протоколе", "MQTT")
Rel(mqtt_broker, smart_devices, "А. Доставляет команду", "MQTT/TLS")
Rel(smart_devices, mqtt_broker, "А. Публикует статус исполнения", "MQTT, async")
Rel(mqtt_broker, device_gateway, "А. Доставляет статус исполнения", "MQTT, подписка")
Rel(device_gateway, event_bus, "А. Публикует DeviceCommandCompleted\nили DeviceCommandFailed", "async, Kafka")

' =====================================================================
' Ветвь Б. Унаследованное устройство: команда идёт через монолит.
' Все 100 подключённых сейчас модулей — модули отопления.
' =====================================================================

Rel(device_management_api, legacy_acl, "Б. Передаёт команду унаследованному устройству", "sync, JSON/HTTPS")
Rel(legacy_acl, monolith, "Б. Вызывает управление отоплением монолита", "sync, JSON/HTTP")
Rel(monolith, smart_devices, "Б. Переключает реле отопления", "HTTP")
Rel(legacy_acl, event_bus, "Б. Публикует результат команды", "async, Kafka")

' =====================================================================
' Схождение ветвей и возврат результата
' =====================================================================

Rel(event_bus, device_management_api, "Доставляет результат команды", "async, Kafka")
RelIndex(LastIndex(), event_bus, notification_api, "Доставляет DeviceCommandFailed", "async, Kafka")

Rel(device_management_api, state_db, "Записывает подтверждённое состояние", "SQL/TCP")
Rel(notification_api, notification_provider, "Уведомляет об отказе команды", "HTTPS, REST")

Rel(spa, api_gateway, "Опрашивает состояние устройства", "sync, JSON/HTTPS")
Rel(api_gateway, device_management_api, "Передаёт запрос состояния", "sync, JSON/HTTPS")
Rel(device_management_api, state_db, "Читает текущее состояние", "SQL/TCP")

' =====================================================================
' Пояснения
' =====================================================================

note as N_decisions
  **Решения разработанного сценария**
  ....
  **Команда — не событие.** Событие можно доставить нескольким
  подписчикам, команду нельзя: прибор включится дважды. Поэтому
  команда идёт точечно (ветви А и Б), а в шину публикуются
  только её результаты — это факты, и потребителей у них
  несколько.
  ....
  **Слои предотвращения искажений симметричны.** Оба переводят
  в обе стороны: шлюз устройств — команду в отраслевой протокол
  и статус обратно, слой к монолиту — команду в вызов монолита
  и результат обратно. Односторонний слой означал бы, что
  управление знает протоколы устройств, и поддержка нового
  протокола требовала бы его правки — то есть сценарий c
  устройствами неизвестного типа стал бы невыполним.
  ....
  **Промежуточное состояние обязательно.** Между отправкой
  команды и подтверждением состояние имеет значение «команда
  отправлена, подтверждение не получено». Без него интерфейсу
  нечего показать, а повторное нажатие не отличить от первого.
  ....
  **Результат возвращается опросом, а не push'ем.** Опрос
  состояния интерфейсу нужен в любом случае и новых контейнеров
  не требует.
  ....
  **Уведомление — только об отказе.** Успех пользователь видит
  в интерфейсе, он сам нажал кнопку. Подписка на все результаты
  создавала бы уведомление на каждое нажатие выключателя.
end note

note as N_scope
  **Границы разработанного сценария**
  ....
  Ветви А и Б взаимоисключающие: выбор делается по исполнителю
  команд, прочитанному из реестра. Добавление нового исполнителя
  (ещё один протокол, ещё одна унаследованная система) —
  запись в реестре, а не правка управления устройствами.
  ....
  Полная структура — diagrams/container/WarmHouse_Container.puml.
end note

SHOW_LEGEND()

@enduml
